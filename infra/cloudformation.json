{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Core 1 simulator: one small EC2 host, retained encrypted exam storage, ECR and GitHub OIDC deployment.",
  "Parameters": {
    "InstanceType": {
      "Type": "String",
      "Default": "t3.micro",
      "AllowedValues": [
        "t3.micro",
        "t3.small"
      ]
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "DomainName": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}$",
      "Description": "Optional domain already pointed at this stack's Elastic IP; empty means HTTP public IP."
    },
    "AllowedWebCidr": {
      "Type": "String",
      "Default": "0.0.0.0/0",
      "AllowedPattern": "^[0-9.]+/[0-9]{1,2}$"
    },
    "ExistingOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:iam::[0-9]{12}:oidc-provider/token.actions.githubusercontent.com$"
    },
    "GitHubOidcSubject": {
      "Type": "String",
      "Default": "repo:Revelation69@97466660/cyber@1327682549:ref:refs/heads/main",
      "AllowedPattern": "^repo:[A-Za-z0-9_./@:-]+:ref:refs/heads/main$"
    }
  },
  "Conditions": {
    "CreateProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingOidcProviderArn"
        },
        ""
      ]
    },
    "HasDomain": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "DomainName"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.73.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.73.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Core 1 web access; management uses SSM, no inbound SSH",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": {
              "Ref": "AllowedWebCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "HttpsIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "WebSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "CidrIp": {
          "Ref": "AllowedWebCidr"
        }
      },
      "Condition": "HasDomain"
    },
    "ImageRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${AWS::StackName}-simulator"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep the latest twenty application images\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 20}, \"action\": {\"type\": \"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DataVolume": {
      "Type": "AWS::EC2::Volume",
      "Properties": {
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Size": 8,
        "VolumeType": "gp3",
        "Encrypted": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "PullSimulatorImage",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ImageRepository",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "Server": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WebSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 8,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/usr/bin/env bash\nset -Eeuo pipefail\nmkdir -p /etc/core1\n",
                "cat > /etc/core1/deploy.env <<'CONFIG'\nREGION=",
                {
                  "Ref": "AWS::Region"
                },
                "\nREPOSITORY=",
                {
                  "Fn::GetAtt": [
                    "ImageRepository",
                    "RepositoryUri"
                  ]
                },
                "\nDOMAIN=",
                {
                  "Ref": "DomainName"
                },
                "\nDATA_VOLUME=",
                {
                  "Ref": "DataVolume"
                },
                "\nCADDY_IMAGE=caddy:2-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b\nCONFIG\n",
                "chmod 600 /etc/core1/deploy.env\ncat > /usr/local/bin/core1-deploy <<'DEPLOY_SCRIPT'\n",
                "#!/usr/bin/env bash\n# Only the immutable ECR digest is supplied by the deployment role.\nset -Eeuo pipefail\nsource /etc/core1/deploy.env\ndigest=${1:?An image digest is required}\n[[ \"$digest\" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo 'Invalid image digest.' >&2; exit 2; }\n[[ -f /etc/core1/bootstrap-complete ]] || { echo 'Host bootstrap is incomplete.' >&2; exit 1; }\nmountpoint -q /var/lib/core1\nexec 9>/var/lock/core1-deploy.lock\nflock -n 9 || { echo 'Another deployment is in progress.' >&2; exit 1; }\nimage=\"$REPOSITORY@$digest\"\nregistry=${REPOSITORY%%/*}\naws ecr get-login-password --region \"$REGION\" | docker login --username AWS --password-stdin \"$registry\"\ndocker pull \"$image\"\n\n# Snapshot SQLite consistently before changing the running version.\nif docker inspect core1-app >/dev/null 2>&1; then\n  docker exec core1-app python -c 'import sqlite3; import time; source=sqlite3.connect(\"/data/exams.sqlite3\"); destination=sqlite3.connect(\"/backups/predeploy-\"+str(int(time.time()))+\".sqlite3\"); source.backup(destination); destination.close(); source.close()'\nfi\n\n# Check the candidate against an isolated empty DB before interrupting the app.\ndocker rm -f core1-candidate 2>/dev/null || true\ndocker run -d --name core1-candidate --read-only --tmpfs /tmp:size=64m \\\n  --tmpfs /data:uid=10001,gid=10001,mode=0700,size=32m --cap-drop ALL \\\n  --security-opt no-new-privileges:true \"$image\"\ncandidate_ok=false\nfor attempt in $(seq 1 30); do\n  if docker exec core1-candidate python -c 'import urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8080/healthz\",timeout=2)' >/dev/null 2>&1; then\n    candidate_ok=true; break\n  fi\n  sleep 2\ndone\nif [[ \"$candidate_ok\" != true ]]; then\n  docker logs --tail=50 core1-candidate\n  docker rm -f core1-candidate\n  exit 1\nfi\ndocker rm -f core1-candidate\n\nprevious=false\nif docker inspect core1-app >/dev/null 2>&1; then\n  docker rm -f core1-previous 2>/dev/null || true\n  docker stop --time 30 core1-app\n  docker rename core1-app core1-previous\n  previous=true\nfi\n\nrollback() {\n  echo 'Deployment failed; restoring the previous container.' >&2\n  docker logs --tail=50 core1-app 2>/dev/null || true\n  docker rm -f core1-app 2>/dev/null || true\n  if [[ \"$previous\" == true ]]; then\n    docker rename core1-previous core1-app\n    docker start core1-app\n  fi\n}\ntrap rollback ERR\nsecure=false\norigin=''\nif [[ -n \"$DOMAIN\" ]]; then secure=true; origin=\"https://$DOMAIN\"; fi\ndocker run -d --name core1-app --restart unless-stopped --init \\\n  --publish 127.0.0.1:8080:8080 --read-only --tmpfs /tmp:size=64m \\\n  --cap-drop ALL --security-opt no-new-privileges:true \\\n  --log-opt max-size=10m --log-opt max-file=3 \\\n  -e SIMULATOR_DATABASE=/data/exams.sqlite3 \\\n  -e SIMULATOR_COOKIE_SECURE=\"$secure\" -e SIMULATOR_PUBLIC_ORIGIN=\"$origin\" \\\n  -v /var/lib/core1/app:/data -v /var/lib/core1/backups:/backups \"$image\"\nhealthy=false\nfor attempt in $(seq 1 30); do\n  if curl --fail --silent http://127.0.0.1:8080/healthz >/dev/null; then healthy=true; break; fi\n  sleep 2\ndone\n[[ \"$healthy\" == true ]]\ntrap - ERR\nprintf '%s\\n' \"$image\" > /var/lib/core1/current-image\n# Keep bounded local backups and reclaim only old unused Docker images.\nfind /var/lib/core1/backups -name 'predeploy-*.sqlite3' -type f -mtime +14 -delete\ndocker image prune --force --filter until=168h\necho \"Healthy deployment: $image\"\n",
                "\nDEPLOY_SCRIPT\nchmod 700 /usr/local/bin/core1-deploy\n",
                "#!/usr/bin/env bash\n# Embedded by render_template.py after /etc/core1/deploy.env is written.\nset -Eeuo pipefail\nsource /etc/core1/deploy.env\ndnf install -y docker jq\ncommand -v aws\nsystemctl enable --now amazon-ssm-agent\n\n# Match the dedicated data volume by its NVMe serial; never format the root disk.\ndevice=''\nfor attempt in $(seq 1 120); do\n  device=$(lsblk -dn -o NAME,SERIAL | awk -v serial=\"${DATA_VOLUME//-/}\" '$2 == serial {print \"/dev/\" $1}')\n  [[ -n \"$device\" ]] && break\n  sleep 5\ndone\n[[ -b \"$device\" ]] || { echo 'Dedicated EBS data volume did not attach.' >&2; exit 1; }\nif ! blkid \"$device\" >/dev/null 2>&1; then\n  mkfs.ext4 -L core1-data \"$device\"\nfi\nmkdir -p /var/lib/core1\nvolume_uuid=$(blkid -s UUID -o value \"$device\")\ngrep -q \"UUID=$volume_uuid \" /etc/fstab || printf 'UUID=%s /var/lib/core1 ext4 defaults,nofail 0 2\\n' \"$volume_uuid\" >> /etc/fstab\nmount /var/lib/core1\nmountpoint -q /var/lib/core1\nmkdir -p /etc/systemd/system/docker.service.d\ncat > /etc/systemd/system/docker.service.d/core1-volume.conf <<'UNIT'\n[Unit]\nRequiresMountsFor=/var/lib/core1\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now docker\nmkdir -p /var/lib/core1/app /var/lib/core1/backups /var/lib/core1/caddy-data /var/lib/core1/caddy-config\nchown 10001:10001 /var/lib/core1/app /var/lib/core1/backups\nchmod 700 /var/lib/core1/backups\n\nsite_address=':80'\n[[ -z \"$DOMAIN\" ]] || site_address=\"$DOMAIN\"\ncat > /etc/core1/Caddyfile <<EOF\n$site_address {\n  encode gzip\n  reverse_proxy 127.0.0.1:8080\n}\nEOF\ndocker pull \"$CADDY_IMAGE\"\ndocker rm -f core1-proxy 2>/dev/null || true\ndocker run -d --name core1-proxy --restart unless-stopped --network host \\\n  --read-only --tmpfs /tmp:size=32m --cap-drop ALL --cap-add NET_BIND_SERVICE \\\n  --security-opt no-new-privileges:true --log-opt max-size=10m --log-opt max-file=3 \\\n  -v /etc/core1/Caddyfile:/etc/caddy/Caddyfile:ro \\\n  -v /var/lib/core1/caddy-data:/data -v /var/lib/core1/caddy-config:/config \"$CADDY_IMAGE\"\ntouch /etc/core1/bootstrap-complete\necho 'Core 1 host ready for an image deployment through Systems Manager.'\n"
              ]
            ]
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-web"
            }
          }
        ]
      },
      "DependsOn": [
        "PublicRoute",
        "SubnetRoute"
      ]
    },
    "DataAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": {
          "Ref": "Server"
        },
        "VolumeId": {
          "Ref": "DataVolume"
        }
      }
    },
    "PublicIp": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      },
      "DependsOn": "GatewayAttachment"
    },
    "IpAttachment": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicIp",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Server"
        }
      }
    },
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      },
      "Condition": "CreateProvider"
    },
    "DeployDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "DocumentType": "Command",
        "DocumentFormat": "JSON",
        "UpdateMethod": "NewVersion",
        "Content": {
          "schemaVersion": "2.2",
          "description": "Deploy a verified ECR digest to the Core 1 host",
          "parameters": {
            "ImageDigest": {
              "type": "String",
              "interpolationType": "ENV_VAR",
              "allowedPattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "mainSteps": [
            {
              "action": "aws:runShellScript",
              "name": "deploy",
              "inputs": {
                "timeoutSeconds": "600",
                "runCommand": [
                  "set -eu",
                  "test -f /etc/core1/bootstrap-complete",
                  "/usr/local/bin/core1-deploy \"$SSM_ImageDigest\""
                ]
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "GitHub main branch may push only this app and run its fixed deployment document",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateProvider",
                    {
                      "Ref": "GitHubProvider"
                    },
                    {
                      "Ref": "ExistingOidcProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Ref": "GitHubOidcSubject"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BuildAndDeploySimulator",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:DescribeImages"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ImageRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:document/${DeployDocument}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Server}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "core1-simulator"
          },
          {
            "Key": "Stack",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Server"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "PublicIp"
      }
    },
    "AppUrl": {
      "Value": {
        "Fn::If": [
          "HasDomain",
          {
            "Fn::Sub": "https://${DomainName}"
          },
          {
            "Fn::Sub": "http://${PublicIp}"
          }
        ]
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "ImageRepository",
          "RepositoryUri"
        ]
      }
    },
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeploymentRole",
          "Arn"
        ]
      }
    },
    "DeploymentDocument": {
      "Value": {
        "Ref": "DeployDocument"
      }
    },
    "DataVolumeId": {
      "Value": {
        "Ref": "DataVolume"
      }
    }
  }
}
